# Copy to .env and adjust. Changes need a restart (dev) or a rebuild (production).

# Backend URL. Default: http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000

# Live captions in the patient interview.
#   browser  (default) words appear while the patient talks, but the browser
#            sends their voice to Google (Chrome) or Microsoft (Edge).
#   whisper  captions come only from Amumata's own AI service; the voice is
#            never sent to Google or Microsoft. Captions appear after each phrase.
# The consent page and therapist agreement wording follow this setting.
VITE_CAPTION_ENGINE=browser
